-- | Daml Script version of submit_attestation.py — same idea (simulate
-- the property manager's system sending in a signed event), but goes
-- straight at the ledger via `dpm script` instead of the JSON API. Use
-- this one when you just want the demo to work; use the Python script
-- when you want to actually show the "external system calling in over
-- HTTP" bit.
--
-- This is its own little package (see daml.yaml here) depending on the
-- main dar. Build order:
--   dpm build                                    # from repo root
--   dpm sandbox --dar .daml/dist/ozmium-cashflow-0.1.0.dar --json-api-port 7575
--   cd integration/mock-attestor && dpm build     # in another terminal
--   dpm script \
--     --dar .daml/dist/ozmium-mock-attestor-0.1.0.dar \
--     --script-name MockAttestor:runMockAttestation \
--     --ledger-host localhost --ledger-port 6865
-- More detail in README.md next to this file.
module MockAttestor where

import DA.Date
import DA.List (find)
import Daml.Script
import Ozmium.Attestation
import Ozmium.Types

-- | Finds a party by display name if Ozmium.Setup:setup already ran on
-- this ledger, otherwise just allocates one. Lets this script work
-- either way without caring which.
getOrAllocateParty : Text -> Script Party
getOrAllocateParty hint = do
  known <- listKnownParties
  case find (\p -> p.displayName == Some hint) known of
    Some p -> pure p.party
    None -> allocatePartyWithHint hint (PartyIdHint hint)

-- | Same numbers as attestation_sample.json, just hardcoded here instead
-- of read from a file.
runMockAttestation : Script ()
runMockAttestation = do
  propManager <- getOrAllocateParty "PropManagerCo"
  berlinSpv   <- getOrAllocateParty "BerlinSPV"

  attestationCid <- submit propManager do
    createCmd RevenueAttestation with
      attestor = propManager
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      revenueType = Rent
      periodStart = date 2026 Jul 1
      periodEnd = date 2026 Jul 31
      grossAmount = 12500.00
      currency = "EUR"
      deductions =
        [ Deduction with deductionType = "management_fee", amount = 500.00
        , Deduction with deductionType = "servicing_fee", amount = 125.00
        ]
      sourceRef = "statement-2026-07-berlin-hauptstrasse-12"

  debug ("Submitted attestation: " <> show attestationCid)
  pure ()
