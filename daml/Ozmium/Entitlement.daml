-- | Checkpoint 3 — figuring out who gets paid what.
--
-- Takes a validated event and splits the net amount across holders.
-- Pro-rata by ownership share is all we need for the demo (the build
-- guide is explicit that pro-rata is fine here), but EntitlementLine and
-- EntitlementCalculation are shaped generically enough that a real
-- waterfall — tranches, hurdle rates, whatever — can drop in later
-- without touching anything else in the pipeline.
--
-- No contract keys in this file either. HoldingsSnapshot and
-- EntitlementCalculation just get passed around by ContractId.
module Ozmium.Entitlement where

import Ozmium.Types
import Ozmium.Settlement

-- | Who owns what, for one asset. In a real deployment this would
-- mirror actual holdings pulled from Canton/Hedera at distribution time;
-- for now the fund just attests it directly. Making it its own contract
-- instead of a field on ValidatedRevenueEvent is the important bit —
-- swap this for a live holdings feed later and nothing upstream or
-- downstream has to change.
template HoldingsSnapshot
  with
    fund     : Party
    assetId  : Text
    holdings : [(Party, Decimal)]  -- (holder, ownership share); shares must sum to 1.0
  where
    signatory fund
    observer [h | (h, _) <- holdings]

    ensure sumDecimals [pct | (_, pct) <- holdings] == 1.0

-- | The calculated split for one validated event. attestor stays on as
-- a signatory here (alongside fund) so the chain back to the original
-- attestation is baked into the ledger itself, not something you have
-- to reconstruct from logs later.
template EntitlementCalculation
  with
    fund              : Party
    attestor          : Party
    assetId           : Text
    revenueType       : RevenueType
    periodStart       : Date
    periodEnd         : Date
    currency          : Text
    netDistributable  : Decimal
    lines             : [EntitlementLine]
    sourceRef         : Text
  where
    signatory fund, attestor
    observer [l.holder | l <- lines]

    -- Checkpoint 4 — turn each line into an actual settlement obligation.
    choice EntitlementCalculation_Settle : [ContractId SettlementInstruction]
      controller fund
      do
        forA lines $ \l ->
          create SettlementInstruction with
            fund
            holder = l.holder
            assetId
            periodStart
            periodEnd
            currency
            amount = l.amount
            sourceEventRef = sourceRef
            status = Pending

-- | Same math as the choice above, just pulled out as a plain function so
-- tests can check it directly instead of going through a ledger
-- submission every time.
calculateEntitlementLines : Decimal -> [(Party, Decimal)] -> [EntitlementLine]
calculateEntitlementLines net holdings =
  [ EntitlementLine with holder = h, share = pct, amount = net * pct
  | (h, pct) <- holdings
  ]
