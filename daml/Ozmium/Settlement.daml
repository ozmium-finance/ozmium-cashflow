-- | Checkpoint 4 — settlement.
--
-- SettlementInstruction is just the fund's obligation to pay a holder a
-- specific amount for a specific event, written on-ledger. No real money
-- moves here — the build guide only asks for the obligation to exist
-- on-ledger, not an actual payout rail. In a real build this is the spot
-- where you'd trigger a DvP payout on Hedera or wherever the token
-- happens to live — Canton's job is orchestrating the money, not caring
-- which chain the token was issued on.
--
-- No contract key on this one either. Whoever needs a
-- SettlementInstruction gets its ContractId back from
-- EntitlementCalculation_Settle, or queries for it.
module Ozmium.Settlement where

data SettlementStatus
  = Pending
  | Paid
  deriving (Eq, Show)

template SettlementInstruction
  with
    fund           : Party
    holder         : Party
    assetId        : Text
    periodStart    : Date
    periodEnd      : Date
    currency       : Text
    amount         : Decimal
    -- Points back to the attestation's source_reference so an auditor
    -- can trace a payout all the way back to the event that caused it.
    sourceEventRef : Text
    status         : SettlementStatus
  where
    signatory fund
    observer holder

    ensure amount > 0.0

    -- Flip to Paid once the actual transfer has happened, off-ledger.
    -- Fund-controlled for now; you'd probably want the holder or some
    -- payment oracle to co-sign this in a real deployment so the fund
    -- can't just mark things paid without anyone checking.
    choice Settlement_MarkPaid : ContractId SettlementInstruction
      controller fund
      do
        create this with status = Paid
