-- | Checkpoint 4: settlement.
--
-- A SettlementInstruction represents, on-ledger, the fund's obligation to
-- pay a specific holder a specific amount for a specific event. It does
-- not move real funds — per the Dev Build Guide, "representing the
-- obligation on-ledger is enough" for the demo. In production this is
-- where a DvP-style payout would be triggered on the token/settlement
-- rail (Hedera HTS, or any other chain — Canton orchestrates the money
-- movement, it does not care which chain the underlying token lives on).
--
-- No contract key: Canton 3.x doesn't support them. Callers look up a
-- SettlementInstruction by ContractId (returned when
-- EntitlementCalculation_Settle is exercised) or via a ledger query.
module Ozmium.Settlement where

data SettlementStatus
  = Pending
  | Paid
  deriving (Eq, Show)

template SettlementInstruction
  with
    fund           : Party
    holder         : Party
    assetId        : Text
    periodStart    : Date
    periodEnd      : Date
    currency       : Text
    amount         : Decimal
    -- Traces back to the originating attestation's source_reference, so a
    -- regulator or auditor can walk SettlementInstruction -> the exact
    -- event that produced it, per the "auditable" requirement in the
    -- Mission Brief and Exhibit A acceptance criteria.
    sourceEventRef : Text
    status         : SettlementStatus
  where
    signatory fund
    observer holder

    ensure amount > 0.0

    -- Marks the obligation as paid once the off-ledger (or Hedera-side)
    -- transfer has actually happened. Kept as a controller-only choice for
    -- the fund in this demo; a real deployment would likely want the
    -- holder or a payment-rail oracle to co-confirm receipt.
    choice Settlement_MarkPaid : ContractId SettlementInstruction
      controller fund
      do
        create this with status = Paid
