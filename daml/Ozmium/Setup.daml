-- | Allocates demo parties and seeds a bit of starting data. Doesn't
-- run automatically — fire it against a live sandbox yourself:
--   dpm script --dar .daml/dist/ozmium-cashflow-0.1.0.dar \
--     --script-name Ozmium.Setup:setup \
--     --ledger-host localhost --ledger-port 6865
-- (Old Daml 2.x `daml start` used to run an init-script for you
-- automatically. dpm's sandbox/script split doesn't do that, so this is
-- a manual step now. Full walkthrough is in the root README.)
--
-- Also doubles as the shared party setup for the tests in
-- tests/scenarios/, so the same party names show up whether you're
-- running the demo or the test suite.
--
-- The scenario throughout: a Berlin residential building owned by an
-- SPV ("BerlinSPV"), rent reported monthly by its property manager
-- ("PropManagerCo"), three investors holding fractional shares.
--
-- Since there's no contract keys to look things up by, `setup` prints
-- the AttestorRegistry and HoldingsSnapshot ids via `debug` — grab those
-- from the script output and pass them into whatever you run next
-- (Attestation_Validate's registryCid, etc).
module Ozmium.Setup where

import Daml.Script
import Ozmium.Validation
import Ozmium.Entitlement

data DemoParties = DemoParties
  with
    admin         : Party
    propManager   : Party  -- the regulated attestor
    berlinSpv     : Party  -- the fund / asset owner
    investor1     : Party
    investor2     : Party
    investor3     : Party

allocateDemoParties : Script DemoParties
allocateDemoParties = do
  admin       <- allocatePartyByHint (PartyIdHint "Admin")
  propManager <- allocatePartyByHint (PartyIdHint "PropManagerCo")
  berlinSpv   <- allocatePartyByHint (PartyIdHint "BerlinSPV")
  investor1   <- allocatePartyByHint (PartyIdHint "InvestorAlice")
  investor2   <- allocatePartyByHint (PartyIdHint "InvestorBob")
  investor3   <- allocatePartyByHint (PartyIdHint "InvestorCarol")
  pure DemoParties with admin, propManager, berlinSpv, investor1, investor2, investor3

setup : Script ()
setup = do
  DemoParties{..} <- allocateDemoParties

  -- PropManagerCo is the authorized attestor for berlin-hauptstrasse-12.
  registryCid <- submit admin do
    createCmd AttestorRegistry with
      admin
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      authorizedAttestor = propManager

  -- 50/30/20 split across the three investors.
  holdingsCid <- submit berlinSpv do
    createCmd HoldingsSnapshot with
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      holdings =
        [ (investor1, 0.50)
        , (investor2, 0.30)
        , (investor3, 0.20)
        ]

  -- Print these since there's no way to look them up by key anymore.
  debug ("AttestorRegistry contract id: " <> show registryCid)
  debug ("HoldingsSnapshot contract id: " <> show holdingsCid)
  pure ()
