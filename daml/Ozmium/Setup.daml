-- | Demo party allocation + seed data. Run explicitly against a running
-- `dpm sandbox` with:
--   dpm script --dar .daml/dist/ozmium-cashflow-0.1.0.dar \
--     --script-name Ozmium.Setup:setup \
--     --ledger-host localhost --ledger-port 6865
-- (There's no daml.yaml `init-script:` auto-run here -- that was a Daml
-- 2.x `daml start` convenience; dpm's sandbox/script split needs it run
-- as a separate step. See README.md for the full local-dev walkthrough.)
--
-- Also used as the shared party-setup helper for the test scenarios in
-- tests/scenarios/, so party names stay consistent between the
-- interactive demo and the automated tests.
--
-- Reference scenario throughout: a Berlin residential property owned by
-- an SPV ("BerlinSPV"), rent collected and reported monthly by its
-- property manager ("PropManagerCo"), fractionally owned by three
-- investors.
--
-- Without contract keys (Canton 3.x doesn't support them), the
-- AttestorRegistry and HoldingsSnapshot ContractIds created here have to
-- be tracked by whoever calls this and passed explicitly into later
-- commands (e.g. Attestation_Validate's registryCid, or
-- ValidatedRevenueEvent_CalculateEntitlement's holdingsCid) -- setup
-- prints them via `debug` so they're visible in script output/logs.
module Ozmium.Setup where

import Daml.Script
import Ozmium.Validation
import Ozmium.Entitlement

data DemoParties = DemoParties
  with
    admin         : Party
    propManager   : Party  -- the regulated attestor
    berlinSpv     : Party  -- the fund / asset owner
    investor1     : Party
    investor2     : Party
    investor3     : Party

allocateDemoParties : Script DemoParties
allocateDemoParties = do
  admin       <- allocatePartyWithHint "Admin" (PartyIdHint "Admin")
  propManager <- allocatePartyWithHint "PropManagerCo" (PartyIdHint "PropManagerCo")
  berlinSpv   <- allocatePartyWithHint "BerlinSPV" (PartyIdHint "BerlinSPV")
  investor1   <- allocatePartyWithHint "InvestorAlice" (PartyIdHint "InvestorAlice")
  investor2   <- allocatePartyWithHint "InvestorBob" (PartyIdHint "InvestorBob")
  investor3   <- allocatePartyWithHint "InvestorCarol" (PartyIdHint "InvestorCarol")
  pure DemoParties with admin, propManager, berlinSpv, investor1, investor2, investor3

setup : Script ()
setup = do
  DemoParties{..} <- allocateDemoParties

  -- Register PropManagerCo as the authorized attestor for property
  -- "berlin-hauptstrasse-12".
  registryCid <- submit admin do
    createCmd AttestorRegistry with
      admin
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      authorizedAttestor = propManager

  -- Seed a holdings snapshot: 50% / 30% / 20% pro-rata split.
  holdingsCid <- submit berlinSpv do
    createCmd HoldingsSnapshot with
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      holdings =
        [ (investor1, 0.50)
        , (investor2, 0.30)
        , (investor3, 0.20)
        ]

  -- No contract keys to look these up by later -- print them so whoever
  -- ran this script can copy them into the mock attestor / demo commands.
  debug ("AttestorRegistry contract id: " <> show registryCid)
  debug ("HoldingsSnapshot contract id: " <> show holdingsCid)
  pure ()
