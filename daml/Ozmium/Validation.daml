-- | Checkpoint 2 — trust-model validation. This is where an attestation
-- either earns the right to trigger money movement or gets rejected.
-- Three things have to hold before that happens:
--
--   1. It's the right party — the attestor is actually the one this
--      asset's registry says is authoritative (AttestorRegistry lookup).
--   2. It's actually signed by them — this one's free, the ledger
--      already guarantees it. RevenueAttestation requires
--      `signatory attestor`, so if the contract exists at all, attestor
--      really did author it.
--   3. It hasn't already been reported for this period — used to be a
--      contract key check, but Canton 3.x doesn't have those anymore.
--      See Attestation_Validate in Attestation.daml for how we handle it
--      now (knownPriorEventCids).
module Ozmium.Validation where

import Ozmium.Types
import Ozmium.Distribution

-- | Whether the current authorizedAttestor is actually allowed to
-- attest right now. Kept as a plain enum alongside a separate
-- `expiresOn` field (rather than folding expiry into the constructor,
-- e.g. `Licensed with expiresOn : Date`) so both fields serialize as
-- plain JSON values -- a bare string, a bare date -- over the ledger
-- API, matching how RevenueType/BasisKind already do this elsewhere in
-- the codebase, instead of a nested variant payload.
data AttestorLicenseState = Active | Revoked deriving (Eq, Show)

-- | Says who's allowed to attest for a given asset, and until when.
-- One admin party controls it for now — fine for a demo, but this is
-- really the trust root of the whole system, so a real deployment
-- probably wants multi-sig or a committee here rather than one key.
-- That's flagged as an open question in the Revenue Attestation
-- Architecture doc too.
--
-- Mission 2 addition: authorization used to be a one-time grant that
-- lasted forever once given. Real attestor relationships expire
-- (a property management contract ends) or need pulling immediately
-- (an attestor is found misreporting) — `licenseState` covers the
-- immediate-pull case, `expiresOn` covers the natural-lapse case.
-- Attestation_Validate in Attestation.daml checks both.
template AttestorRegistry
  with
    admin              : Party
    fund               : Party
    assetId            : Text
    authorizedAttestor : Party
    licenseState       : AttestorLicenseState
    expiresOn          : Date
  where
    signatory admin
    observer fund, authorizedAttestor

    -- | Swap in a different attestor entirely -- resets to Active with
    -- a fresh expiry, since this is a new licensing decision, not a
    -- continuation of whatever state the previous attestor was in.
    choice AttestorRegistry_Replace : ContractId AttestorRegistry
      with
        newAttestor  : Party
        newExpiresOn : Date
      controller admin
      do
        create this with authorizedAttestor = newAttestor, licenseState = Active, expiresOn = newExpiresOn

    -- | Pull the current attestor's authorization immediately,
    -- independent of expiresOn -- e.g. they lost the underlying
    -- property-management contract, or were found misreporting.
    -- Attestation_Validate rejects any attestation from this attestor
    -- from this point on, even if expiresOn hasn't been reached yet.
    choice AttestorRegistry_Revoke : ContractId AttestorRegistry
      controller admin
      do
        create this with licenseState = Revoked

    -- | Extend (or explicitly shorten) how long the current attestor
    -- stays licensed, without changing who the attestor is. Also lifts
    -- a Revoked registry back to Active -- re-licensing the same
    -- attestor after revoking them is a legitimate admin decision (the
    -- issue that caused the revocation got resolved), and doesn't need
    -- a separate choice from renewing an about-to-expire one.
    choice AttestorRegistry_Renew : ContractId AttestorRegistry
      with
        newExpiresOn : Date
      controller admin
      do
        create this with licenseState = Active, expiresOn = newExpiresOn

-- | An attestation that made it through validation. This is the line
-- between "someone said this happened" and "we now treat it as fact and
-- start calculating money against it." Both attestor and fund sign it —
-- attestor because it's their original claim, fund because they're the
-- one accepting it under the trust model.
template ValidatedRevenueEvent
  with
    attestor          : Party
    fund              : Party
    assetId           : Text
    revenueType       : RevenueType
    periodStart       : Date
    periodEnd         : Date
    grossAmount       : Decimal
    currency          : Text
    deductions        : [Deduction]
    netDistributable  : Decimal
    sourceRef         : Text
  where
    signatory attestor, fund

    ensure netDistributable > 0.0

    -- This used to go straight to entitlement calculation from here.
    -- It doesn't anymore -- a design review pointed out that collapses
    -- two real settlement layers into one: property-level netting
    -- (this contract, deductions already applied) and the SPV's
    -- separate decision about how much of that net income actually
    -- gets passed through versus retained (reserve, debt service,
    -- whatever). See Distribution.daml for that step. `fund` controls
    -- it since it's their call to make; attestor's signature comes
    -- along from the contract being consumed, same as before.
    choice ValidatedRevenueEvent_DecideDistribution : ContractId DistributionDecision
      with
        retentionAmount : Decimal
        retentionReason : Text
      controller fund
      do
        create DistributionDecision with
          fund
          attestor
          assetId
          revenueType
          periodStart
          periodEnd
          currency
          netOperatingIncome = netDistributable
          retentionAmount
          retentionReason
          passThroughAmount = netDistributable - retentionAmount
          sourceRef
