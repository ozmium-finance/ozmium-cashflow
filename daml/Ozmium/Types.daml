-- | Shared types for the cashflow pattern. Kept generic on purpose —
-- real estate rent is the first use case but bonds/private credit
-- (coupons, loan repayments) are supposed to reuse this same shape in
-- phase two, so nothing here should be real-estate-specific.
module Ozmium.Types where

-- | What kind of event we're attesting to. `Other` is just an escape
-- hatch for stuff we haven't modeled yet (fund distributions, etc).
data RevenueType
  = Rent
  | Coupon
  | LoanRepayment
  | Distribution
  | Other
  deriving (Eq, Show)

-- | One deduction against the gross amount (management fee, servicing
-- fee...). We keep these itemized instead of taking a pre-netted number
-- from the servicer — otherwise the waterfall math happens off-ledger
-- and we lose the whole point of doing this on Canton.
data Deduction = Deduction
  with
    deductionType : Text
    amount        : Decimal
  deriving (Eq, Show)

-- | One line of a calculated entitlement — a holder, their share, and
-- what that share works out to in money.
data EntitlementLine = EntitlementLine
  with
    holder : Party
    share  : Decimal
    amount : Decimal
  deriving (Eq, Show)

-- | Just a small convenience wrapper so we're not writing `foldl (+) 0.0`
-- in three different modules.
sumDecimals : [Decimal] -> Decimal
sumDecimals = foldl (+) 0.0
