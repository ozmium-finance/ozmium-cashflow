-- | Shared types for the cashflow pattern. Kept generic on purpose —
-- real estate rent is the first use case but bonds/private credit
-- (coupons, loan repayments) are supposed to reuse this same shape in
-- phase two, so nothing here should be real-estate-specific.
module Ozmium.Types where

-- | What kind of event we're attesting to. `Other` is just an escape
-- hatch for stuff we haven't modeled yet (fund distributions, etc).
-- `TokenVesting` added for the Mission 2 standalone Distribution Engine
-- work -- a vesting checkpoint/TGE release, as opposed to a recurring
-- revenue period.
data RevenueType
  = Rent
  | Coupon
  | LoanRepayment
  | Distribution
  | TokenVesting
  | Other
  deriving (Eq, Show)

-- | Which entitlement-table shape produced a given EntitlementCalculation
-- -- recorded on the calculation itself so a report/audit trail can say
-- which one without needing to reconstruct it from context. Deliberately
-- a plain enum with no embedded ContractId reference (unlike, say,
-- carrying the actual HoldingsSnapshot/AllocationTable id inline) so
-- this can live in Types.daml at the bottom of the module graph instead
-- of forcing a dependency between Entitlement.daml and Allocation.daml
-- in both directions.
data BasisKind
  = Waterfall     -- ^ recurring per-period split against a HoldingsSnapshot (Entitlement.daml)
  | FixedVesting  -- ^ static allocation released against a vesting schedule (Allocation.daml)
  deriving (Eq, Show)

-- | One deduction against the gross amount (management fee, servicing
-- fee...). We keep these itemized instead of taking a pre-netted number
-- from the servicer — otherwise the waterfall math happens off-ledger
-- and we lose the whole point of doing this on Canton.
data Deduction = Deduction
  with
    deductionType : Text
    amount        : Decimal
  deriving (Eq, Show)

-- | One line of a calculated entitlement — a holder, their share, and
-- what that share works out to in money.
data EntitlementLine = EntitlementLine
  with
    holder : Party
    share  : Decimal
    amount : Decimal
  deriving (Eq, Show)

-- | Just a small convenience wrapper so we're not writing `foldl (+) 0.0`
-- in three different modules.
sumDecimals : [Decimal] -> Decimal
sumDecimals = foldl (+) 0.0
