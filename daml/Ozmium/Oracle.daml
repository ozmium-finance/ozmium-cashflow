-- | STRETCH GOAL — oracle corroboration. Optional, and kept in its own
-- module on purpose so it can be dropped entirely without touching
-- Attestation/Validation/Entitlement/Settlement. None of those import
-- this file.
--
-- Only makes sense for event types where a real public number exists to
-- check against — a bond's published coupon rate is the example in the
-- Mission brief. We're deliberately not wiring this up for real estate
-- rent, because there's no independent source for what rent actually
-- came in. Someone still has to be the attestor either way; an oracle
-- can corroborate a claim, it can't discover the fact on its own.
--
-- Modeled here as a single reporting party for simplicity — a real
-- Chainlink-style setup would aggregate several independent nodes before
-- posting anything.
module Ozmium.Oracle where

data CorroborationStatus
  = Confirmed
  | Mismatch
  deriving (Eq, Show)

-- | Checks a publicly known rate against what the attestor claimed.
-- This is a signal, not a gate — nothing in the core flow waits on or
-- checks for one of these existing.
template OracleCorroboration
  with
    oracle        : Party
    fund          : Party
    bondId        : Text
    periodStart   : Date
    periodEnd     : Date
    publishedRate : Decimal  -- e.g. coupon rate from a prospectus / published benchmark
    attestedRate  : Decimal  -- the rate claimed in the corresponding RevenueAttestation
    toleranceBps  : Decimal  -- acceptable deviation, in basis points (e.g. 1.0 = 1bp)
  where
    signatory oracle
    observer fund

    choice OracleCorroboration_Check : CorroborationStatus
      controller fund
      do
        let diffBps = abs (publishedRate - attestedRate) * 10000.0
        pure $ if diffBps <= toleranceBps then Confirmed else Mismatch
