-- | Checkpoint 1 — attestation. Also has the choice that bridges into
-- Checkpoint 2 (validation), since it made more sense to keep that logic
-- next to the contract it consumes rather than splitting it out.
--
-- A RevenueAttestation is just a signed claim: "attestor says €X came in
-- for property Y, period Z". The attestor is a property manager, a
-- servicer, whoever's contractually on the hook for the number being
-- right. This is the trust model the Mission brief says is required —
-- oracle corroboration (Ozmium.Oracle) is a nice-to-have on top, not a
-- substitute, and it lives in its own module entirely so it can't leak
-- into this one.
--
-- Field names roughly follow the attestation JSON schema from the
-- Revenue Attestation Architecture doc, mostly so the mock attestor
-- integration doesn't have to do much translation.
--
-- One thing worth flagging up front: this file used to use Daml contract
-- keys for duplicate-period protection, back when it was written against
-- Daml 2.x assumptions. Canton 3.x dropped contract keys entirely — no
-- key/maintainer/fetchByKey/lookupByKey/exerciseByKey, confirmed by DA
-- engineering on the Canton forum ("Contract keys in DAML 3") — because
-- you can't guarantee uniqueness across independent synchronizers. See
-- Attestation_Validate below for what replaced it.
module Ozmium.Attestation where

import DA.Action (forA_)
import DA.Assert
import Ozmium.Types
import Ozmium.Validation

template RevenueAttestation
  with
    attestor     : Party
    fund         : Party
    assetId      : Text
    revenueType  : RevenueType
    periodStart  : Date
    periodEnd    : Date
    grossAmount  : Decimal
    currency     : Text
    deductions   : [Deduction]
    sourceRef    : Text
  where
    -- `signatory attestor` is doing all the work for "an unauthorized
    -- party can't create one" — nobody but attestor can bring this
    -- contract into existence, full stop, nothing to check on our end.
    signatory attestor
    observer fund

    ensure grossAmount > 0.0 && periodEnd >= periodStart

    -- Checkpoint 2 lives here: validate against the trust model, and if
    -- it holds up, turn this into a ValidatedRevenueEvent. `fund` is the
    -- controller since they're the one deciding whether to trust the
    -- registry's answer. attestor's authority just comes along for the
    -- ride because we're consuming a contract they signed.
    choice Attestation_Validate : ContractId ValidatedRevenueEvent
      with
        registryCid : ContractId AttestorRegistry
        -- No contract keys means the ledger can't prove by itself that
        -- this period hasn't been validated before. The real fix is
        -- off-ledger: whoever's submitting this (the fund's automation)
        -- should check the participant/PQS for an existing
        -- ValidatedRevenueEvent first and just not submit if it finds
        -- one. This param is the on-ledger backstop for that — pass in
        -- any ValidatedRevenueEvent ids you already know about for this
        -- asset and we'll fetch them and fail hard if one matches this
        -- period. Pass [] if there's nothing to check yet.
        knownPriorEventCids : [ContractId ValidatedRevenueEvent]
      controller fund
      do
        registry <- fetch registryCid
        registry.fund === fund
        assertMsg
          ("Registry is for asset " <> registry.assetId <> ", not " <> assetId)
          (registry.assetId == assetId)
        assertMsg
          ("Attestor " <> show attestor <> " is not the registered attestor for asset " <> assetId)
          (registry.authorizedAttestor == attestor)

        forA_ knownPriorEventCids $ \priorCid -> do
          priorEvent <- fetch priorCid
          assertMsg
            ("Revenue event for asset " <> assetId <> " and this period has already been validated (found via knownPriorEventCids)")
            (not (priorEvent.fund == fund
                  && priorEvent.assetId == assetId
                  && priorEvent.periodStart == periodStart
                  && priorEvent.periodEnd == periodEnd))

        let totalDeductions = sumDecimals [d.amount | d <- deductions]
        let net = grossAmount - totalDeductions
        assertMsg "Net distributable amount must be positive after deductions" (net > 0.0)

        create ValidatedRevenueEvent with
          attestor
          fund
          assetId
          revenueType
          periodStart
          periodEnd
          grossAmount
          currency
          deductions
          netDistributable = net
          sourceRef
