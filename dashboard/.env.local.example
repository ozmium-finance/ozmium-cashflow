# Copy this file to .env.local and adjust if dpm sandbox isn't on the
# default host/port. The API proxy route (pages/api/v2/[...path].js)
# reads these server-side -- same two knobs serve.py took as CLI args
# for the old plain-HTML dashboard.
JSON_API_HOST=localhost
JSON_API_PORT=7575

# Optional: point the dashboard at a real Canton network instead of the
# local sandbox (e.g. ozmium-devnet-1). Fill in all four -- get them from
# the relevant Authentik application's Provider page (Client ID / Client
# Secret / Token URL) -- then set LEDGER_TARGET=devnet as a separate,
# explicit opt-in. Leaving LEDGER_TARGET unset keeps sandbox mode even if
# these four are already filled in, so credentials can sit here ready to
# go without silently redirecting the existing sandbox scenarios.
# LEDGER_API_URL=
# LEDGER_API_CLIENT_ID=
# LEDGER_API_CLIENT_SECRET=
# LEDGER_API_TOKEN_URL=
# LEDGER_API_SCOPE=daml_ledger_api
# LEDGER_TARGET=devnet

# Required for the "Link Alice's Canton PartyID to a DFNS wallet" and
# "Relink" onboarding-scenario steps -- these create real DFNS-custodied
# wallets on CantonTestnet via lib/dfnsServer.js. No opt-in flag like
# LEDGER_TARGET here since wallet creation only ever happens on an
# explicit button click in the onboarding scenario, not passively on
# every page load.
#
# DFNS_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64: base64 of the PEM private key
#   whose matching public key was registered when the Service Account was
#   created (Settings > Developers > Service Accounts > New Service
#   Account). Generate with:
#     openssl genrsa -out sa.pem 2048
#     openssl pkey -in sa.pem -pubout -out sa.pub.pem   # paste this one into DFNS
#     base64 -w0 sa.pem                                  # this becomes the env value
# DFNS_SERVICE_ACCOUNT_AUTH_TOKEN: the one-time-shown token from that same
#   Service Account creation screen.
# DFNS_CREDENTIAL_ID: shown next to the Service Account in the Service
#   Accounts list ("Cred ID" column).
# DFNS_ORG_ID: Settings > Organization ("Org ID"), format or-xxxxx-xxxxx-...
# DFNS_API_URL: https://api.dfns.io (Europe default -- see DFNS docs for
#   other regions).
# DFNS_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=
# DFNS_SERVICE_ACCOUNT_AUTH_TOKEN=
# DFNS_CREDENTIAL_ID=
# DFNS_ORG_ID=
# DFNS_API_URL=https://api.dfns.io
