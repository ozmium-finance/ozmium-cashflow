-- | Checkpoint 4 — settlement, and the full chain end to end.
--
-- Done when: attestation -> validation -> entitlement -> settlement runs
-- all the way through, and you can trace any payout back to the event
-- that caused it.
module Checkpoint4_Settlement where

import DA.Assert
import DA.Date
import DA.Foldable (forA_)
import DA.List (sortOn)
import Daml.Script
import Ozmium.Attestation
import Ozmium.Validation
import Ozmium.Entitlement
import Ozmium.Settlement
import Ozmium.Types
import Ozmium.Setup

test_fullLifecycleEndToEnd : Script ()
test_fullLifecycleEndToEnd = script do
  DemoParties{..} <- allocateDemoParties

  -- checkpoint 1: attestation
  registryCid <- submit admin do
    createCmd AttestorRegistry with
      admin
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      authorizedAttestor = propManager

  holdingsCid <- submit berlinSpv do
    createCmd HoldingsSnapshot with
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      holdings = [(investor1, 0.50), (investor2, 0.30), (investor3, 0.20)]

  let periodStart = date 2026 Jul 1
  let periodEnd   = date 2026 Jul 31
  let sourceRef   = "statement-2026-07-berlin-hauptstrasse-12"

  attestationCid <- submit propManager do
    createCmd RevenueAttestation with
      attestor = propManager
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      revenueType = Rent
      periodStart
      periodEnd
      grossAmount = 12500.00
      currency = "EUR"
      deductions =
        [ Deduction with deductionType = "management_fee", amount = 500.00
        , Deduction with deductionType = "servicing_fee", amount = 125.00
        ]
      sourceRef

  -- checkpoint 2: validation
  validatedCid <- submit berlinSpv do
    exerciseCmd attestationCid Attestation_Validate with registryCid, knownPriorEventCids = []

  Some validated <- queryContractId berlinSpv validatedCid
  validated.netDistributable === 11875.00  -- 12500 - 500 - 125

  -- checkpoint 3: entitlement calculation
  entitlementCid <- submit berlinSpv do
    exerciseCmd validatedCid ValidatedRevenueEvent_CalculateEntitlement with holdingsCid

  Some entitlement <- queryContractId berlinSpv entitlementCid
  entitlement.sourceRef === sourceRef

  -- checkpoint 4: settlement
  settlementCids <- submit berlinSpv do
    exerciseCmd entitlementCid EntitlementCalculation_Settle

  settlements <- forA settlementCids (queryContractId berlinSpv)
  let paidOut = [s | Some s <- settlements]
  length paidOut === 3

  -- this is the auditability check that matters: every settlement
  -- carries the source_reference back to the attestation that caused
  -- it, and the total settled matches the validated event's net amount
  -- exactly. someone auditing this later shouldn't need anything but
  -- the ledger to walk a payout back to its source event.
  forA_ paidOut $ \s -> s.sourceEventRef === sourceRef
  let totalSettled = sum [s.amount | s <- paidOut]
  totalSettled === entitlement.netDistributable

  -- each investor should be able to see their own instruction
  let byHolder = sortOn (\s -> show s.holder) paidOut
  length byHolder === 3

  -- and the fund can mark one paid once the actual transfer clears
  -- (e.g. a Hedera stablecoin transfer confirming on the other side)
  let (firstSettlementCid :: _) = settlementCids
  paidCid <- submit berlinSpv do
    exerciseCmd firstSettlementCid Settlement_MarkPaid
  Some paidSettlement <- queryContractId berlinSpv paidCid
  paidSettlement.status === Paid
