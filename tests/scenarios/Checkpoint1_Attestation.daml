-- | Checkpoint 1 — attestation.
--
-- Done when: the attestor can create an attestation, and nobody else can.
module Checkpoint1_Attestation where

import DA.Assert
import DA.Date
import Daml.Script
import Ozmium.Attestation
import Ozmium.Types
import Ozmium.Setup

-- PropManagerCo attests to July rent for berlin-hauptstrasse-12.
test_attestorCanCreateAttestation : Script ()
test_attestorCanCreateAttestation = script do
  DemoParties{..} <- allocateDemoParties

  attestationCid <- submit propManager do
    createCmd RevenueAttestation with
      attestor = propManager
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      revenueType = Rent
      periodStart = date 2026 Jul 1
      periodEnd = date 2026 Jul 31
      grossAmount = 12500.00
      currency = "EUR"
      deductions =
        [ Deduction with deductionType = "management_fee", amount = 625.00
        , Deduction with deductionType = "servicing_fee", amount = 120.00
        ]
      sourceRef = "statement-2026-07-berlin-hauptstrasse-12"

  -- both attestor and fund should be able to see it
  Some attestation <- queryContractId propManager attestationCid
  attestation.grossAmount === 12500.00

  Some _ <- queryContractId berlinSpv attestationCid
  pure ()

-- Someone who isn't PropManagerCo tries to submit an attestation
-- claiming to be them. Should fail outright — the ledger won't even
-- let the command through, since impostor has no authority to act as
-- attestor.
test_unauthorizedPartyCannotCreateAttestation : Script ()
test_unauthorizedPartyCannotCreateAttestation = script do
  DemoParties{..} <- allocateDemoParties
  impostor <- allocatePartyByHint (PartyIdHint "Impostor")

  submitMustFail impostor do
    createCmd RevenueAttestation with
      attestor = propManager  -- claiming to be PropManagerCo
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      revenueType = Rent
      periodStart = date 2026 Jul 1
      periodEnd = date 2026 Jul 31
      grossAmount = 999999.00
      currency = "EUR"
      deductions = []
      sourceRef = "forged-statement"

-- Bad data (zero/negative amount, or period end before period start)
-- gets caught by `ensure`, even from the real attestor.
test_malformedAttestationRejected : Script ()
test_malformedAttestationRejected = script do
  DemoParties{..} <- allocateDemoParties

  submitMustFail propManager do
    createCmd RevenueAttestation with
      attestor = propManager
      fund = berlinSpv
      assetId = "berlin-hauptstrasse-12"
      revenueType = Rent
      periodStart = date 2026 Jul 31
      periodEnd = date 2026 Jul 1  -- end before start
      grossAmount = 12500.00
      currency = "EUR"
      deductions = []
      sourceRef = "bad-period"
